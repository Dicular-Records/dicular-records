---
// Seitenrahmen des Redesigns: Kopfleiste mit Chrome-Menü (mittig), Fußzeile, Player-Leiste, Entwurf-Umschalter.
// Startseite mit Logo-Intro (intro), Unterseiten mit sofort sichtbarer Kopfleiste.
import site from '../data/site.json';
import menuData from '../data/hauptmenue.json';
import { getCollection } from 'astro:content';
import { coverColor } from '../lib/cover-color';

interface Props {
  title: string;
  description?: string;
  /** Vorschaubild beim Teilen */
  image?: string;
  /** Startseite: Logo-Intro statt fertiger Kopfleiste */
  intro?: boolean;
  /** V2: Farbe der Seite (sonst die des neuesten erschienenen Releases) */
  accent?: string;
}
const { title, description = site.description, image = site.shareImage, intro = false, accent } = Astro.props;
const newest = (await getCollection('releases')).filter((r) => !r.data.upcoming && r.data.date).sort((a, b) => +b.data.date! - +a.data.date!)[0];
const pageColor = accent ?? await coverColor(newest?.data.cover);
const fullTitle = intro ? site.name : `${title} | ${site.name}`;
const shareImage = new URL(image, Astro.site).href;
const logo = '/wp-content/uploads/2022/01/Logo_Dicular-Rec-Metal-600x600-2.png';
// Menü aus src/data/hauptmenue.json (in Decap unter „Menü“ pflegbar): Eintrag zeigt auf eine Seite (page) oder eine Adresse (link)
const counts: Record<string, number> = { releases: (await getCollection('releases')).length, artists: (await getCollection('artists')).length, news: (await getCollection('news')).length };
const menu = (menuData.items as { label: string; page?: string; link?: string; hint?: string }[])
  .map((m) => [m.label, m.page ? `/${m.page}/` : (m.link ?? '/'), (m.hint ?? '').replace(/\{(\w+)\}/g, (x, k) => String(counts[k] ?? x))]);
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en" style={`--c:${pageColor}`} data-own-accent={accent ? "" : undefined}>
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta name="robots" content="noindex" />
	<title>{fullTitle}</title>
	<meta name="description" content={description} />
	<meta property="og:title" content={fullTitle} />
	<meta property="og:description" content={description} />
	<meta property="og:image" content={shareImage} />
	<meta name="twitter:card" content="summary_large_image" />
	<link rel="icon" href={site.favicon} />
	<link rel="stylesheet" href="/redesign/site.css" />
	<link rel="stylesheet" href="/v2/site.css" />
	<!-- Nur Entwurf: im Menü „Cover wählen“ gesetzte Farbe gilt auch auf Seiten ohne eigenes Cover -->
	<script is:inline>try { var u = new URLSearchParams(location.search).get("menu"); if (u) localStorage.setItem("v2-menu", u); var m = u || localStorage.getItem("v2-menu") || "f"; document.documentElement.classList.add("menu-" + m); if (m === "e") document.documentElement.classList.add("menu-a"); var c = localStorage.getItem("v2-aktuell-c"); if (c && !("ownAccent" in document.documentElement.dataset)) document.documentElement.style.setProperty("--c", c); } catch (e) {}</script>
</head>
<body class={`logo-coin sep-a ${intro ? 'home' : 'sub scrolled intro-done'}`}>
	<div id="atmos" aria-hidden="true"><div id="rille"><div class="r-chrome"><i></i></div></div></div>
	<header class="top" id="top">
		<a href={intro ? '#intro' : '/entwurf/'} class="top-logo" aria-label="Dicular Records – Home" data-title="Home" data-hint="Back to the start page"><img src={logo} alt="" width="40" height="40" /></a>
		<button class="menu-toggle" aria-expanded="false" aria-controls="nav">Menu</button>
		<!-- Menü-Idee F: Beschriftung und Buchsen links auf dem Panel, Schalter für den Ton -->
		<div class="syn-left" aria-hidden="true">
			<span class="syn-screen" id="synScreen"><b id="synLine1">Dicular DR-1</b><span id="synLine2">Signal Path</span></span>
			<span class="syn-socket"><span class="syn-jack" id="synOut"></span>Out</span>
			<span class="syn-socket"><span class="syn-jack" id="synHome"></span>Home</span>
		</div>
		<button type="button" class="syn-sound" id="synSound" aria-pressed="false" aria-label="Klick-Ton an oder aus" data-title="Sound" data-hint="Turns the click of the knobs on or off"><i></i>Sound</button>
		<nav class="nav chrome-nav" id="nav" aria-label="Main menu" style={`--n:${menu.length}`}>
			{menu.map(([label, href, hint], i) => <a href={href} style={`--i:${i}`} data-hint={hint || undefined} aria-current={path.startsWith(href) ? 'page' : undefined}><span class="syn-dial" aria-hidden="true"><span class="syn-knob"><i></i></span></span><span class="syn-label">{label}</span><span class="syn-jack" aria-hidden="true"></span></a>)}
		</nav>
	</header>

	<slot />

	<footer class="foot">
		<img src={logo} alt="" width="64" height="64" />
		<p class="social">{site.social.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.icon.replace('qticon-', '')}</a>)}</p>
		<p class="legal"><a href="/impressum/">Impressum</a> · <a href="/privacy-policy/">Privacy Policy</a></p>
		<p class="copy">© {new Date().getFullYear()} Dicular Records</p>
	</footer>

	<audio id="player" preload="none"></audio>
	<!-- Player-Leiste: erscheint, sobald etwas läuft (Release-Tracks oder Radio) -->
	<div class="playerbar" id="playerbar" hidden>
		<div class="pb-buttons">
			<button class="pb-prev" id="pbPrev" aria-label="Previous track"><i></i></button>
			<button class="pb-toggle" id="pbToggle" aria-label="Play/Pause"><i></i></button>
			<button class="pb-next" id="pbNext" aria-label="Next track"><i></i></button>
		</div>
		<div class="pb-info"><strong id="pbTitle"></strong><em id="pbArtist"></em></div>
		<div class="pb-time"><span id="pbCur">0:00</span><input type="range" id="pbSeek" min="0" max="1000" value="0" aria-label="Track position" /><span id="pbDur">0:00</span></div>
		<span class="pb-source" id="pbSource"></span>
	</div>

	<!-- Umschalter nur im Entwurf: Varianten vergleichen (Yoka/Tomtron) -->
	<details class="switcher" id="switcher" open aria-label="Entwurf-Varianten">
		<summary>Entwurf</summary>
		{intro && <div><span>Logo</span><button data-set="logo" data-val="coin">Münze</button><button data-set="logo" data-val="record">Schallplatte</button></div>}
		<div><span>Abgrenzung</span><button data-set="sep" data-val="a" title="Nur Raum, Milchglas beim Scrollen">A</button><button data-set="sep" data-val="b" title="Chrome-Lichtkante">B</button><button data-set="sep" data-val="c" title="Weicher Schatten">C</button></div>
		{intro && <div><button data-replay>Intro nochmal</button></div>}
	</details>

	<script is:inline src="/redesign/site.js"></script>
	<script is:inline src="/v2/site.js"></script>
	<script is:inline src="/v2/synth.js"></script>
</body>
</html>
