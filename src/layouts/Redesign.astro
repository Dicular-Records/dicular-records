---
// Seitenrahmen des Redesigns: Kopfleiste mit Chrome-Menü (mittig), Fußzeile, Player-Leiste, Entwurf-Umschalter.
// Startseite mit Logo-Intro (intro), Unterseiten mit sofort sichtbarer Kopfleiste.
import site from '../data/site.json';

interface Props {
  title: string;
  description?: string;
  /** Vorschaubild beim Teilen */
  image?: string;
  /** Startseite: Logo-Intro statt fertiger Kopfleiste */
  intro?: boolean;
}
const { title, description = site.description, image = site.shareImage, intro = false } = Astro.props;
const fullTitle = intro ? site.name : `${title} | ${site.name}`;
const shareImage = new URL(image, Astro.site).href;
const logo = '/wp-content/uploads/2022/01/Logo_Dicular-Rec-Metal-600x600-2.png';
const menu = [['Releases', '/releases/'], ['Digital', '/dicular-digital/'], ['Mixes', '/mixes/'], ['News', '/dicular-rec-news/'], ['Artists', '/artists/'], ['Events', '/gigs/'], ['Friends', '/friends/'], ['Team', '/team/'], ['About Us', '/about/'], ['Contact', '/sample-page/']];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta name="robots" content="noindex" />
	<title>{fullTitle}</title>
	<meta name="description" content={description} />
	<meta property="og:title" content={fullTitle} />
	<meta property="og:description" content={description} />
	<meta property="og:image" content={shareImage} />
	<meta name="twitter:card" content="summary_large_image" />
	<link rel="icon" href={site.favicon} />
	<link rel="stylesheet" href="/redesign/site.css" />
</head>
<body class={`logo-coin sep-a ${intro ? 'home' : 'sub scrolled intro-done'}`}>
	<header class="top" id="top">
		<a href={intro ? '#intro' : '/entwurf/'} class="top-logo" aria-label="Dicular Records – Home"><img src={logo} alt="" width="40" height="40" /></a>
		<button class="menu-toggle" aria-expanded="false" aria-controls="nav">Menu</button>
		<nav class="nav chrome-nav" id="nav" aria-label="Main menu">
			{menu.map(([label, href], i) => <a href={href} style={`--i:${i}`} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}
		</nav>
	</header>

	<slot />

	<footer class="foot">
		<img src={logo} alt="" width="64" height="64" />
		<p class="social">{site.social.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.icon.replace('qticon-', '')}</a>)}</p>
		<p class="legal"><a href="/impressum/">Impressum</a> · <a href="/privacy-policy/">Privacy Policy</a></p>
		<p class="copy">© {new Date().getFullYear()} Dicular Records</p>
	</footer>

	<audio id="player" preload="none"></audio>
	<!-- Player-Leiste: erscheint, sobald etwas läuft (Release-Tracks oder Radio) -->
	<div class="playerbar" id="playerbar" hidden>
		<div class="pb-buttons">
			<button class="pb-prev" id="pbPrev" aria-label="Previous track"><i></i></button>
			<button class="pb-toggle" id="pbToggle" aria-label="Play/Pause"><i></i></button>
			<button class="pb-next" id="pbNext" aria-label="Next track"><i></i></button>
		</div>
		<div class="pb-info"><strong id="pbTitle"></strong><em id="pbArtist"></em></div>
		<div class="pb-time"><span id="pbCur">0:00</span><input type="range" id="pbSeek" min="0" max="1000" value="0" aria-label="Track position" /><span id="pbDur">0:00</span></div>
		<span class="pb-source" id="pbSource"></span>
	</div>

	<!-- Umschalter nur im Entwurf: Varianten vergleichen (Yoka/Tomtron) -->
	<details class="switcher" id="switcher" open aria-label="Entwurf-Varianten">
		<summary>Entwurf</summary>
		{intro && <div><span>Logo</span><button data-set="logo" data-val="coin">Münze</button><button data-set="logo" data-val="record">Schallplatte</button></div>}
		<div><span>Abgrenzung</span><button data-set="sep" data-val="a" title="Nur Raum, Milchglas beim Scrollen">A</button><button data-set="sep" data-val="b" title="Chrome-Lichtkante">B</button><button data-set="sep" data-val="c" title="Weicher Schatten">C</button></div>
		{intro && <div><button data-replay>Intro nochmal</button></div>}
	</details>

	<script is:inline src="/redesign/site.js"></script>
</body>
</html>
