---
// Artist-Website (Demo, Idee 2026-11-13): eigene Seite eines Artists auf Basis des Dicular-Designs.
// Rahmen wie Redesign.astro, aber mit dem Synth-Menü (Idee F) fest, eigenen Menüpunkten, Foto im Display und eigener Fußzeile.
// Später unter einer Subdomain (yoka.dicular-records.com), bis dahin unter /site/<artist>/.
import type { CollectionEntry } from 'astro:content';
import site from '../data/site.json';
import { artistName } from '../lib/redesign';

export interface SiteMenuItem { key: string; label: string; href: string; hint: string }
interface Props {
  artist: CollectionEntry<'artists'>;
  menu: SiteMenuItem[];
  /** aktueller Menüpunkt */
  current: string;
  title: string;
  description?: string;
  accent: string;
}
const { artist, menu, current, title, description, accent } = Astro.props;
const name = artistName(artist.data.name).name;
const fullTitle = current === 'home' ? `${name} | DJ and Producer` : `${title} | ${name}`;
const photo = artist.data.photo;
const home = menu[0].href;
---
<!doctype html>
<html lang="en" class="menu-f artist-site" style={`--c:${accent}`} data-own-accent="">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta name="robots" content="noindex" />
	<title>{fullTitle}</title>
	<meta name="description" content={description ?? `${name}, DJ and producer on Dicular Records`} />
	<meta property="og:title" content={fullTitle} />
	{photo && <meta property="og:image" content={new URL(photo, Astro.site).href} />}
	<link rel="icon" href={site.favicon} />
	<link rel="stylesheet" href="/redesign/site.css" />
	<link rel="stylesheet" href="/v2/site.css" />
	<link rel="stylesheet" href="/v2/artist-site.css" />
</head>
<body class="logo-coin sep-a sub scrolled intro-done">
	<div id="atmos" aria-hidden="true"><div id="rille"><div class="r-chrome"><i></i></div></div></div>
	<header class="top" id="top">
		<a href={home} class="top-logo" aria-label={`${name} – Home`} data-title="Home" data-hint={`Back to the start page of ${name}`}>
			{photo ? <img src={photo} alt="" width="46" height="46" /> : <span class="site-initial">{name.slice(0, 1)}</span>}
		</a>
		<button class="menu-toggle" aria-expanded="false" aria-controls="nav">Menu</button>
		<div class="syn-left" aria-hidden="true">
			<span class="syn-screen" id="synScreen"><b id="synLine1">{name}</b><span id="synLine2">on Dicular Records</span></span>
			<span class="syn-socket"><span class="syn-jack" id="synOut"></span>Out</span>
			<span class="syn-socket"><span class="syn-jack" id="synHome"></span>Home</span>
		</div>
		<button type="button" class="syn-sound" id="synSound" aria-pressed="false" aria-label="Klick-Ton an oder aus" data-title="Sound" data-hint="Turns the click of the knobs on or off"><i></i>Sound</button>
		<nav class="nav chrome-nav" id="nav" aria-label="Main menu" style={`--n:${menu.length}`}>
			{menu.map((m, i) => <a href={m.href} style={`--i:${i}`} data-hint={m.hint} aria-current={m.key === current ? 'page' : undefined}><span class="syn-dial" aria-hidden="true"><span class="syn-knob"><i></i></span></span><span class="syn-label">{m.label}</span><span class="syn-jack" aria-hidden="true"></span></a>)}
		</nav>
	</header>

	<slot />

	<footer class="foot site-foot">
		<p class="site-foot-name">{name}</p>
		<p class="legal"><a href={`${home}contact/`}>Booking</a> · <a href="/impressum/">Impressum</a> · <a href="/privacy-policy/">Privacy Policy</a></p>
		<p class="site-label"><a href={`/artist/${artist.id}/`}><img src="/wp-content/uploads/2022/01/Logo_Dicular-Rec-Metal-600x600-2.png" alt="" width="28" height="28" />on Dicular Records</a></p>
	</footer>

	<audio id="player" preload="none"></audio>
	<div class="playerbar" id="playerbar" hidden>
		<div class="pb-buttons">
			<button class="pb-prev" id="pbPrev" aria-label="Previous track"><i></i></button>
			<button class="pb-toggle" id="pbToggle" aria-label="Play/Pause"><i></i></button>
			<button class="pb-next" id="pbNext" aria-label="Next track"><i></i></button>
		</div>
		<div class="pb-info"><strong id="pbTitle"></strong><em id="pbArtist"></em></div>
		<div class="pb-time"><span id="pbCur">0:00</span><input type="range" id="pbSeek" min="0" max="1000" value="0" aria-label="Track position" /><span id="pbDur">0:00</span></div>
		<span class="pb-source" id="pbSource"></span>
	</div>

	<script is:inline src="/redesign/site.js"></script>
	<script is:inline src="/v2/site.js"></script>
	<script is:inline src="/v2/synth.js"></script>
</body>
</html>
