---
// Tag-Archiv (/tag/<term>/, 10 pro Seite)
import PostArchive from '../../../components/PostArchive.astro';
import { newsSorted } from '../../../lib/content';
import { wpPaginate } from '../../../lib/paginate';
import taxonomies from '../../../data/taxonomies.json';

export async function getStaticPaths() {
  const news = await newsSorted();
  // nur Tags, die mindestens ein Beitrag trägt (die Demo-Tags des Themes wurden entfernt)
  return Object.keys(taxonomies.tag).filter((term) => news.some((n) => n.data.tags.includes(term))).flatMap((term) =>
    wpPaginate(news.filter((n) => n.data.tags.includes(term)), 10, `/tag/${term}/`, {})
      .map((p) => ({ params: { term, page: p.params.page }, props: p.props })));
}
const { term } = Astro.params;
const { pageInfo } = Astro.props;
---
<PostArchive kind="tag" slug={term!} termId={(taxonomies.ids.tag as Record<string, number>)[term!]}
	heading={(taxonomies.tag as Record<string, string>)[term!]} pageInfo={pageInfo} />
