---
// Redesign V2, Startseite: schwarzer Grund, Chrome-Logo als Lichtquelle, die Cover bestimmen die Farbe der Seite.
// Abschnitte mit data-c färben die Seite um, sobald sie in der Bildmitte liegen (public/v2/site.js).
import Redesign from '../../layouts/Redesign.astro';
import RTracks from '../../components/RTracks.astro';
import { releasesSorted, artistsSorted, eventsSorted, newsSorted, fmtShort, plainText } from '../../lib/content';
import { thumb, audio } from '../../lib/media';
import { artistName } from '../../lib/redesign';
import { coverColor } from '../../lib/cover-color';

const releases = await releasesSorted();
// oben das neueste erschienene Release (nicht die angekündigten)
const latest = releases.find((r) => !r.data.upcoming)!;
const rest = releases.filter((r) => r !== latest);
const withColor = async (r: (typeof releases)[number]) => ({ r, c: await coverColor(r.data.cover) });
const latestColor = await coverColor(latest.data.cover);
const bands = await Promise.all(rest.slice(0, 3).map(withColor));
const tiles = await Promise.all(rest.slice(3, 11).map(withColor));
const artists = await artistsSorted();
const events = (await eventsSorted()).reverse().slice(0, 4);
const news = (await newsSorted()).slice(0, 3);
const today = new Date();
const radio = releases.flatMap((r) => r.data.tracks.filter((t) => t.mp3).map((t) => ({ title: t.title || r.data.title, artist: t.artist, src: audio(t.mp3)! })));
const logo = '/wp-content/uploads/2022/01/Logo_Dicular-Rec-Metal-600x600-2.png';
const day = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', timeZone: 'UTC' });
const mon = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });
// Katalognummer steht schon in der Zeile darüber
const cleanTitle = (t: string) => t.replace(/^DIC[\s_-]?\d+[\s_:-]*/i, '').replace(/\s+DIC\d+$/i, '').replace(/_/g, ' ');
const size = (t: string) => (cleanTitle(t).length > 34 ? 'v2-title long' : 'v2-title');
---
<Redesign title="Startseite" intro accent={latestColor}>
	<!-- Intro: Logo wie im Filmvorspann -->
	<section class="intro" id="intro" data-c={latestColor}>
		<div class="intro-logo" id="introLogo">
			<img src={logo} alt="Dicular Records" width="600" height="600" />
			<span class="shine"></span><span class="flash"></span>
		</div>
		<h1 class="intro-title chrome-text">Dicular Records</h1>
		<a href="#latest" class="scroll-hint" aria-label="Scroll to the latest release"><span></span></a>
	</section>

	<main>
		<!-- Neuestes Release: Cover randlos, großer Titel -->
		<section class="v2-hero" id="latest" data-c={latestColor}>
			<a class="v2-hero-cover" href={`/release/${latest.id}/`}><img src={latest.data.cover} alt={latest.data.title} width="1000" height="1000" fetchpriority="high" /></a>
			<div class="v2-hero-info" data-reveal>
				<p class="kicker">{latest.data.catalog ? `${latest.data.catalog} · ` : ''}Out now on {latest.data.label}</p>
				<h2 class={size(latest.data.title)}>{cleanTitle(latest.data.title)}</h2>
				<RTracks release={latest} />
				<div class="actions">
					<a class="btn" href={`/release/${latest.id}/`}>View Release</a>
					{latest.data.buyLinks[0]?.url && <a class="btn ghost" href={latest.data.buyLinks[0].url} target="_blank" rel="noopener">{latest.data.buyLinks[0].label || 'Buy'}</a>}
				</div>
			</div>
		</section>

		<!-- Die nächsten Releases: groß, jedes färbt beim Scrollen die Seite -->
		<section>
			{bands.map(({ r, c }) => (
				<a class="v2-band" href={`/release/${r.id}/`} data-c={c}>
					<div class="v2-band-cover" data-reveal><img src={r.data.cover} alt="" width="900" height="900" loading="lazy" /></div>
					<div class="v2-band-info" data-reveal>
						<p class="kicker">{r.data.upcoming ? 'Coming soon' : r.data.catalog ?? r.data.label}</p>
						<h2 class={size(r.data.title)}>{cleanTitle(r.data.title)}</h2>
					</div>
				</a>
			))}
		</section>

		<!-- Katalog -->
		<section>
			<div class="v2-head"><h2 class="section-title chrome-text" data-reveal>Releases</h2></div>
			<div class="v2-grid">
				{tiles.map(({ r, c }) => (
					<a class="v2-tile" href={`/release/${r.id}/`} data-c-hover={c}>
						<img src={thumb(r.data.cover, 'gridthumb')} alt={r.data.title} width="500" height="500" loading="lazy" />
						<span>{r.data.title}</span>
					</a>
				))}
			</div>
			<p class="v2-more" data-reveal><a class="btn ghost" href="/releases/">All Releases</a></p>
		</section>

		<!-- Dicular Radio -->
		<section class="radio" data-reveal>
			<div class="wrap radio-inner">
				<button class="radio-disc" id="radioBtn" aria-label="Start Dicular Radio" data-playlist={JSON.stringify(radio)}>
					<img src={logo} alt="" width="600" height="600" /><i></i>
				</button>
				<div>
					<p class="kicker">Dicular Radio</p>
					<h2 class="headline small">All releases. Shuffled.</h2>
					<p class="now" id="radioNow">{radio.length} Tracks · tap the disc to start the radio</p>
				</div>
			</div>
		</section>

		<!-- Artists: Namen statt Karten -->
		<section>
			<div class="v2-head"><h2 class="section-title chrome-text" data-reveal>Artists</h2></div>
			<ul class="v2-names">
				{artists.map((a) => {
					const name = artistName(a.data.name).name;
					return <li data-reveal><a href={`/artist/${a.id}/`}>{name}{a.data.photo && <img src={thumb(a.data.photo, 'gridthumb')} alt="" width="128" height="128" loading="lazy" />}</a></li>;
				})}
			</ul>
		</section>

		<!-- Events + News -->
		<section class="block split">
			<div class="wrap split-grid">
				<div data-reveal>
					<h2 class="section-title chrome-text">Events</h2>
					<ul class="gigs">
						{events.map((e) => (
							<li><a href={`/event/${e.id}/`}>
								<span class="date"><b>{day(e.data.date)}</b>{mon(e.data.date)}</span>
								<span class="gig"><strong>{e.data.title}</strong><em>{[e.data.location, e.data.city].filter(Boolean).join(', ') || '—'}</em></span>
								<span class={`badge ${e.data.date >= today ? 'up' : ''}`}>{e.data.date >= today ? 'Upcoming' : 'Past'}</span>
							</a></li>
						))}
					</ul>
				</div>
				<div data-reveal style="--d:120ms">
					<h2 class="section-title chrome-text">News</h2>
					<div class="news">
						{news.map((n) => (
							<a href={`/${n.id}/`} class="news-item">
								{n.data.image && <img src={thumb(n.data.image, 'gridthumb')} alt="" width="500" height="500" loading="lazy" />}
								<span><time>{fmtShort(n.data.date)}</time><strong>{n.data.title}</strong><em>{plainText(n.data.excerpt ?? n.body, 90)}</em></span>
							</a>
						))}
					</div>
				</div>
			</div>
		</section>
	</main>
</Redesign>
