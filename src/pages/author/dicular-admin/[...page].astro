---
// Redesign: Autoren-Archiv — alle Beiträge stammen vom WordPress-Benutzer „admin“ (= das Label)
import Redesign from '../../../layouts/Redesign.astro';
import RPageHead from '../../../components/RPageHead.astro';
import RNewsGrid from '../../../components/RNewsGrid.astro';
import { newsSorted } from '../../../lib/content';

export function getStaticPaths() {
  return [{ params: { page: undefined } }];
}
const items = await newsSorted();
---
<Redesign title="Dicular Records" description="All posts by Dicular Records">
	<main>
		<RPageHead title="Dicular Records" kicker="Author" intro={`${items.length} posts`} image={items[0]?.data.image} />
		<section class="block"><div class="wrap"><RNewsGrid items={items} /></div></section>
	</main>
</Redesign>
