---
// Autoren-Archiv (alle Beiträge stammen vom WordPress-Benutzer "admin")
import PostArchive from '../../../components/PostArchive.astro';
import { newsSorted } from '../../../lib/content';
import { wpPaginate } from '../../../lib/paginate';

export async function getStaticPaths() {
  return wpPaginate(await newsSorted(), 10, '/author/dicular-admin/');
}
const { pageInfo } = Astro.props;
const heading = 'Author: <span class="vcard"><a class="url fn n" href="/author/dicular-admin/" title="admin" rel="me">admin</a></span>';
---
<PostArchive kind="author" slug="dicular-admin" termId={1} heading={heading} pageInfo={pageInfo} />
