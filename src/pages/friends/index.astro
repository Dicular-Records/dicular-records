---
// V2: Friends. Befreundete Labels, Künstler und Partner wie hingeworfen, mit Tätigkeiten.
import Redesign from '../../layouts/Redesign.astro';
import RPageHead from '../../components/RPageHead.astro';
import V2Scatter from '../../components/V2Scatter.astro';
import { friendsSorted, plainText } from '../../lib/content';
import { thumb } from '../../lib/media';
import { memberTypeName } from '../../lib/redesign';
import { coverColor } from '../../lib/cover-color';

const friends = await friendsSorted();
const tiles = await Promise.all(friends.map(async (f) => {
  const img = f.data.listImage ?? f.data.headerImage ?? f.data.profilePic;
  return { href: `/members/${f.id}/`, src: thumb(img, 'gridthumb'), label: f.data.name, c: await coverColor(img), meta: f.data.memberTypes.map(memberTypeName).join(' · ') || plainText(f.data.excerpt, 60) };
}));
---
<Redesign title="Friends" description="Friends and partners of Dicular Records">
	<main>
		<RPageHead title="Friends" kicker="Labels · Artists · Partners" intro="The people and projects we work with." />
		<section class="v2-sec"><V2Scatter items={tiles} /></section>
	</main>
</Redesign>
