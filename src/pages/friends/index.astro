---
// Redesign: Friends — befreundete Labels, Künstler und Partner als schräge Karten mit Tätigkeiten.
import Redesign from '../../layouts/Redesign.astro';
import RPageHead from '../../components/RPageHead.astro';
import RCard from '../../components/RCard.astro';
import { friendsSorted, plainText } from '../../lib/content';
import { thumb } from '../../lib/media';
import { memberTypeName } from '../../lib/redesign';

const friends = await friendsSorted();
---
<Redesign title="Friends" description="Friends and partners of Dicular Records">
	<main>
		<RPageHead title="Friends" kicker="Labels · Artists · Partners" intro="The people and projects we work with." />
		<section class="block">
			<div class="wrap">
				<div class="cards friends">
					{friends.map((f, i) => (
						<div class="friend-tile">
							<RCard href={`/members/${f.id}/`} src={thumb(f.data.listImage ?? f.data.headerImage ?? f.data.profilePic, 'gridthumb')} label={f.data.name} tilt={(['l', 'r', 's'] as const)[i % 3]} delay={(i % 4) * 80} />
							<p class="tile-meta" data-reveal style={`--d:${(i % 4) * 80 + 60}ms`}>{f.data.memberTypes.map(memberTypeName).join(' · ') || plainText(f.data.excerpt, 60)}</p>
						</div>
					))}
				</div>
			</div>
		</section>
	</main>
</Redesign>
