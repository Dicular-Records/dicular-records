---
// Redesign: Artist-Seite. Kopf mit schrägem Foto + Namensbalken, Name in Chrome, Rollen/Herkunft, Sprungmarken;
// darunter Biografie, Releases, SoundCloud (Zwei-Klick), Booking, eigener Abschnitt, weitere Artists.
import { getCollection } from 'astro:content';
import Redesign from '../../layouts/Redesign.astro';
import RCard from '../../components/RCard.astro';
import Body from '../../components/RBody.astro';
import SoundCloud from '../../components/SoundCloud.astro';
import { releasesSorted, relatedArtists, plainText } from '../../lib/content';
import { thumb } from '../../lib/media';
import { sanitizeArtistHtml as clean } from '../../lib/sanitize';
import { artistName, cleanSubtitle } from '../../lib/redesign';
import taxonomies from '../../data/taxonomies.json';

export async function getStaticPaths() {
  return (await getCollection('artists')).map((artist) => ({ params: { slug: artist.id }, props: { artist } }));
}
const { artist } = Astro.props;
const a = artist.data;
const { name, roles } = artistName(a.name);
const origin = cleanSubtitle(a.subtitle);
// Releases, an denen der Artist beteiligt ist (im Original nur bei gesetztem „Music“-Titel sichtbar)
const music = (await releasesSorted()).filter((r) => r.data.artists.some((ref) => ref.id === artist.id));
const musicTitle = a.music?.title || 'Releases';
const related = (await relatedArtists(artist)).filter((x) => x.id !== artist.id).slice(0, 4);
// Artist-Genres haben in WordPress keinen eigenen Anzeigenamen → Kürzel lesbar machen
const genreName = (g: string) => (taxonomies.genre as Record<string, string>)[g] ?? g.replace(/-/g, ' ');
const sections = [
  { id: 'bio', label: 'Biography' },
  ...(music.length ? [{ id: 'music', label: musicTitle }] : []),
  ...(a.soundcloud.length ? [{ id: 'soundcloud', label: 'SoundCloud' }] : []),
  ...(a.booking.length ? [{ id: 'booking', label: 'Booking' }] : []),
  ...(a.custom?.title ? [{ id: 'custom', label: a.custom.title }] : []),
];
---
<Redesign title={name} description={plainText(a.excerpt ?? artist.body)} image={a.photo}>
	<main>
		<section class="latest artist-head" style={`--cover:url("${a.background ?? a.photo}")`}>
			<div class="latest-bg" aria-hidden="true"></div>
			<div class="wrap latest-grid">
				<RCard href={a.photo ?? '#bio'} src={a.photo} label={name} portrait width={800} height={1000} eager class="latest-cover" />
				<div class="latest-info" data-reveal>
					<p class="crumb"><a href="/artists/">Artists</a></p>
					{(roles || origin) && <p class="kicker">{[roles, origin].filter(Boolean).join(' · ')}</p>}
					<h1 class="artist-name chrome-text">{name}</h1>
					{a.genres.length > 0 && <p class="chips">{a.genres.map((g) => <span class="chip ghost">{genreName(g)}</span>)}</p>}
					<nav class="jump" aria-label="Sections">{sections.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}</nav>
				</div>
			</div>
		</section>

		<section class="block" id="bio">
			<div class="wrap narrow">
				<h2 class="section-title" data-reveal>Biography</h2>
				<div class="prose" data-reveal><Body entry={artist} /></div>
			</div>
		</section>

		{music.length > 0 && (
			<section class="block" id="music">
				<div class="wrap">
					<h2 class="section-title" data-reveal>{musicTitle}</h2>
					<div class="cards">
						{music.map((r, i) => <RCard href={`/release/${r.id}/`} src={thumb(r.data.cover, 'gridthumb')} label={r.data.title} tilt={i % 2 ? 'r' : 'l'} delay={(i % 4) * 80} />)}
					</div>
				</div>
			</section>
		)}

		{a.soundcloud.length > 0 && (
			<section class="block" id="soundcloud">
				<div class="wrap narrow">
					<h2 class="section-title" data-reveal>SoundCloud</h2>
					{a.soundcloud.map((url) => <SoundCloud url={url} />)}
				</div>
			</section>
		)}

		{(a.booking.length > 0 || a.custom?.title) && (
			<section class="block">
				<div class="wrap narrow">
					{a.booking.length > 0 && (
						<div id="booking" data-reveal>
							<h2 class="section-title">Booking</h2>
							<dl class="booking">
								{a.booking.map((b) => <Fragment><dt>{b.label}</dt><dd set:html={clean(b.value)} /></Fragment>)}
							</dl>
						</div>
					)}
					{a.custom?.title && (
						<div id="custom" data-reveal>
							<h2 class="section-title">{a.custom.title}</h2>
							{a.custom.content && <div class="prose" set:html={clean(a.custom.content)} />}
						</div>
					)}
				</div>
			</section>
		)}

		{related.length > 0 && (
			<section class="block">
				<div class="wrap">
					<h2 class="section-title" data-reveal>More Artists</h2>
					<div class="cards">
						{related.map((x, i) => <RCard href={`/artist/${x.id}/`} src={x.data.photo} label={artistName(x.data.name).name} portrait tilt={(['l', 'r', 's'] as const)[i % 3]} delay={i * 80} />)}
					</div>
					<p class="more" data-reveal><a class="btn ghost" href="/artists/">All Artists</a></p>
				</div>
			</section>
		)}
	</main>
</Redesign>
