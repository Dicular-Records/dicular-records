---
// Redesign: Mixes — DJ-Sets und Promo-Mixe der Dicular-Artists (SoundCloud), neueste zuerst.
import { getCollection } from 'astro:content';
import Redesign from '../../layouts/Redesign.astro';
import RPageHead from '../../components/RPageHead.astro';
import RMixes from '../../components/RMixes.astro';
import site from '../../data/site.json';

const mixes = (await getCollection('mixes')).sort((a, b) => +b.data.date - +a.data.date || a.data.title.localeCompare(b.data.title));
const hours = Math.round(mixes.reduce((s, m) => s + (m.data.duration ?? 0), 0) / 60);
const soundcloud = site.social.find((s) => s.href.includes('soundcloud'))?.href ?? 'https://soundcloud.com/dicular-records';
---
<Redesign title="Mixes" description="DJ sets and promo mixes by the Dicular Records artists">
	<main>
		<RPageHead title="Mixes" kicker="Dicular Sets" intro={`${mixes.length} DJ sets and promo mixes, about ${hours} hours of music.`} />
		<section class="block">
			<div class="wrap">
				<RMixes mixes={mixes} />
				<p class="more" data-reveal><a class="btn ghost" href={soundcloud} target="_blank" rel="noopener">Dicular on SoundCloud</a></p>
			</div>
		</section>
	</main>
</Redesign>
