---
// Redesign: Genre-Archiv — Releases des Genres als schräge Karten
import Redesign from '../../../layouts/Redesign.astro';
import RPageHead from '../../../components/RPageHead.astro';
import RCard from '../../../components/RCard.astro';
import { releasesSorted } from '../../../lib/content';
import { thumb } from '../../../lib/media';
import taxonomies from '../../../data/taxonomies.json';

export function getStaticPaths() {
  return Object.keys(taxonomies.genre).map((term) => ({ params: { term } }));
}
const { term } = Astro.params as { term: string };
const name = (taxonomies.genre as Record<string, string>)[term].replace(/-/g, ' ');
const releases = (await releasesSorted()).filter((r) => r.data.genres.includes(term));
---
<Redesign title={name} description={`${name} releases on Dicular Records`} image={releases[0]?.data.cover}>
	<main>
		<RPageHead title={name} kicker="Genre" intro={`${releases.length} ${releases.length === 1 ? 'release' : 'releases'}`} image={releases[0]?.data.cover} />
		<section class="block"><div class="wrap">
			{releases.length === 0 ? <p class="page-intro" data-reveal>No releases yet.</p> : (
				<div class="cards">{releases.map((r, i) => <RCard href={`/release/${r.id}/`} src={thumb(r.data.cover, 'gridthumb')} label={r.data.title} tilt={i % 2 ? 'r' : 'l'} delay={(i % 4) * 80} />)}</div>
			)}
			<p class="more" data-reveal><a class="btn ghost" href="/releases/">All Releases</a></p>
		</div></section>
	</main>
</Redesign>
