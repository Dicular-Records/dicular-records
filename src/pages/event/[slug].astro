---
// V2: Event-Seite. Flyer schräg, Titel greift darüber, die Seite trägt die Farbe des Flyers; Beschreibung (meist Line-up); weitere Events.
import { getCollection } from 'astro:content';
import Redesign from '../../layouts/Redesign.astro';
import RBody from '../../components/RBody.astro';
import V2Events from '../../components/V2Events.astro';
import { eventsSorted, plainText } from '../../lib/content';
import { coverColor } from '../../lib/cover-color';
import { titleClass, titleFit, cleanTitle } from '../../lib/v2';

export async function getStaticPaths() {
  return (await getCollection('events')).map((event) => ({ params: { slug: event.id }, props: { event } }));
}
const { event } = Astro.props;
const e = event.data;
const today = new Date(new Date().toISOString().slice(0, 10));
const upcoming = e.date >= today;
const others = (await eventsSorted()).filter((x) => x.id !== event.id).reverse().slice(0, 4);
const fmt = (o: Intl.DateTimeFormatOptions, d = e.date) => d.toLocaleDateString('en-GB', { ...o, timeZone: 'UTC' });
const address = [e.street, e.city, e.country].filter(Boolean).join(', ');
const hasBody = (event.body ?? '').replace(/<[^>]+>|&nbsp;|\s/g, '').length > 0;
---
<Redesign title={e.title} description={plainText(`${fmt({ day: 'numeric', month: 'long', year: 'numeric' })}${e.location ? ` · ${e.location}` : ''}. ${e.excerpt ?? event.body ?? ''}`)} image={e.image} accent={e.image ? await coverColor(e.image) : undefined}>
	<main>
		<section class={`v2-hero sub${e.image ? '' : ' no-image'}`}>
			{e.image && <a href={e.image} class="card tilt-l v2-hero-cover" data-reveal><img src={e.image} alt={e.title} width="900" height="900" fetchpriority="high" /></a>}
			<div class="v2-hero-info" data-reveal>
				<p class="crumb"><a href="/gigs/">Events</a></p>
				<div class="event-when">
					<span class="date big"><b>{fmt({ day: '2-digit' })}</b>{fmt({ month: 'short', year: 'numeric' })}</span>
					<span><span class={`badge ${upcoming ? 'up' : ''}`}>{upcoming ? 'Upcoming' : 'Past'}</span><em>{fmt({ weekday: 'long' })}</em></span>
				</div>
				<h1 class={titleClass(e.title)} style={titleFit(e.title)}>{cleanTitle(e.title)}</h1>
				{(e.location || address) && (
					<p class="event-where"><strong>{e.location}</strong>{address && <span>{address}</span>}</p>
				)}
				{(e.eventUrl || e.buyLinks.length > 0) && (
					<div class="actions">
						{e.buyLinks.map((b) => <a class="btn" href={b.url} target="_blank" rel="noopener">{b.label || 'Tickets'}</a>)}
						{e.eventUrl && <a class="btn ghost" href={e.eventUrl} target="_blank" rel="noopener">Event page</a>}
					</div>
				)}
			</div>
		</section>

		{hasBody && (
			<section class="block">
				<div class="v2-text"><div class="prose" data-reveal><RBody entry={event} /></div></div>
			</section>
		)}

		{others.length > 0 && (
			<section class="v2-sec">
				<div class="v2-head right"><h2 class="section-title chrome-text" data-reveal>More Events</h2></div>
				<div class="v2-rows"><V2Events items={others} /></div>
				<p class="v2-more" data-reveal><a class="btn ghost" href="/gigs/">All Events</a></p>
			</section>
		)}
	</main>
</Redesign>
