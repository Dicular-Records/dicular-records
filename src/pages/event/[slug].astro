---
// Redesign: Event-Seite — Flyer schräg, Datumsblock, Ort/Adresse, Event-Link und Tickets; Beschreibung (meist Line-up); weitere Events.
import { getCollection } from 'astro:content';
import Redesign from '../../layouts/Redesign.astro';
import RBody from '../../components/RBody.astro';
import { eventsSorted, plainText } from '../../lib/content';
import { thumb } from '../../lib/media';

export async function getStaticPaths() {
  return (await getCollection('events')).map((event) => ({ params: { slug: event.id }, props: { event } }));
}
const { event } = Astro.props;
const e = event.data;
const today = new Date(new Date().toISOString().slice(0, 10));
const upcoming = e.date >= today;
const others = (await eventsSorted()).filter((x) => x.id !== event.id).reverse().slice(0, 4);
const fmt = (o: Intl.DateTimeFormatOptions, d = e.date) => d.toLocaleDateString('en-GB', { ...o, timeZone: 'UTC' });
const address = [e.street, e.city, e.country].filter(Boolean).join(', ');
const hasBody = (event.body ?? '').replace(/<[^>]+>|&nbsp;|\s/g, '').length > 0;
---
<Redesign title={e.title} description={plainText(`${fmt({ day: 'numeric', month: 'long', year: 'numeric' })}${e.location ? ` · ${e.location}` : ''}. ${e.excerpt ?? event.body ?? ''}`)} image={e.image}>
	<main>
		<section class={`latest event-head${e.image ? '' : ' no-image'}`} style={e.image ? `--cover:url("${e.image}")` : undefined}>
			{e.image && <div class="latest-bg" aria-hidden="true"></div>}
			<div class={`wrap ${e.image ? 'latest-grid' : 'narrow'}`}>
				{e.image && <a href={e.image} class="card tilt-l latest-cover" data-reveal><img src={e.image} alt={e.title} width="900" height="900" fetchpriority="high" /></a>}
				<div class="latest-info" data-reveal>
					<p class="crumb"><a href="/gigs/">Events</a></p>
					<div class="event-when">
						<span class="date big"><b>{fmt({ day: '2-digit' })}</b>{fmt({ month: 'short', year: 'numeric' })}</span>
						<span><span class={`badge ${upcoming ? 'up' : ''}`}>{upcoming ? 'Upcoming' : 'Past'}</span><em>{fmt({ weekday: 'long' })}</em></span>
					</div>
					<h1 class="headline">{e.title}</h1>
					{(e.location || address) && (
						<p class="event-where"><strong>{e.location}</strong>{address && <span>{address}</span>}</p>
					)}
					{(e.eventUrl || e.buyLinks.length > 0) && (
						<div class="actions">
							{e.buyLinks.map((b) => <a class="btn" href={b.url} target="_blank" rel="noopener">{b.label || 'Tickets'}</a>)}
							{e.eventUrl && <a class="btn ghost" href={e.eventUrl} target="_blank" rel="noopener">Event page</a>}
						</div>
					)}
				</div>
			</div>
		</section>

		{hasBody && (
			<section class="block">
				<div class="wrap narrow">
					<div class="prose" data-reveal><RBody entry={event} /></div>
				</div>
			</section>
		)}

		{others.length > 0 && (
			<section class="block">
				<div class="wrap">
					<h2 class="section-title" data-reveal>More Events</h2>
					<ul class="gig-list">
						{others.map((x, i) => (
							<li data-reveal style={`--d:${i * 60}ms`}>
								<a href={`/event/${x.id}/`} class="gig-row">
									<span class="date"><b>{fmt({ day: '2-digit' }, x.data.date)}</b>{fmt({ month: 'short', year: 'numeric' }, x.data.date)}</span>
									<span class="gig-flyer">{x.data.image && <img src={thumb(x.data.image, 'thumbnail')} alt="" width="150" height="150" loading="lazy" />}</span>
									<span class="gig"><em class="gig-day">{fmt({ weekday: 'long' }, x.data.date)}</em><strong>{x.data.title}</strong><em>{[x.data.location, x.data.city].filter(Boolean).join(', ')}</em></span>
									<span class={`badge ${x.data.date >= today ? 'up' : ''}`}>{x.data.date >= today ? 'Upcoming' : 'Past'}</span>
								</a>
							</li>
						))}
					</ul>
					<p class="more" data-reveal><a class="btn ghost" href="/gigs/">All Events</a></p>
				</div>
			</section>
		)}
	</main>
</Redesign>
