---
// Redesign: Events (Adresse bleibt /gigs/) — kommende Termine zuerst (aufsteigend), danach vergangene (neueste zuerst).
import Redesign from '../../layouts/Redesign.astro';
import RPageHead from '../../components/RPageHead.astro';
import { eventsSorted, plainText } from '../../lib/content';
import { thumb } from '../../lib/media';

const events = await eventsSorted();
const today = new Date(new Date().toISOString().slice(0, 10));
const upcoming = events.filter((e) => e.data.date >= today);
const past = events.filter((e) => e.data.date < today).reverse();
const day = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', timeZone: 'UTC' });
const mon = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const wd = (d: Date) => d.toLocaleDateString('en-GB', { weekday: 'long', timeZone: 'UTC' });
const groups = [
  { title: 'Upcoming', items: upcoming, empty: 'New dates coming soon.' },
  { title: 'Past', items: past, empty: '' },
];
---
<Redesign title="Events" description="Events and gigs by Dicular Records">
	<main>
		<RPageHead title="Events" kicker="Dicular Records" intro={upcoming.length ? `${upcoming.length} upcoming ${upcoming.length === 1 ? 'event' : 'events'}.` : 'Label nights, club shows and open airs.'} image={(upcoming[0] ?? past[0])?.data.image} />
		{groups.filter((g) => g.items.length || g.empty).map((g) => (
			<section class="block">
				<div class="wrap">
					<h2 class="section-title" data-reveal>{g.title}</h2>
					{g.items.length === 0 ? <p class="page-intro" data-reveal>{g.empty}</p> : (
						<ul class="gig-list">
							{g.items.map((e, i) => (
								<li data-reveal style={`--d:${(i % 4) * 60}ms`}>
									<a href={`/event/${e.id}/`} class="gig-row">
										<span class="date"><b>{day(e.data.date)}</b>{mon(e.data.date)}</span>
										<span class="gig-flyer">{e.data.image && <img src={thumb(e.data.image, 'thumbnail')} alt="" width="150" height="150" loading="lazy" />}</span>
										<span class="gig">
											<em class="gig-day">{wd(e.data.date)}</em>
											<strong>{e.data.title}</strong>
											<em>{[e.data.location, e.data.street, e.data.city, e.data.country].filter(Boolean).join(', ') || plainText(e.data.excerpt ?? e.body, 90) || ''}</em>
										</span>
										<span class={`badge ${g.title === 'Upcoming' ? 'up' : ''}`}>{g.title}</span>
									</a>
								</li>
							))}
						</ul>
					)}
				</div>
			</section>
		))}
	</main>
</Redesign>
