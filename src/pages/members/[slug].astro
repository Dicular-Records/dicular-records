---
// Redesign: Friend-Seite — Profilbild schräg mit Namensbalken über dem Kopfbild, Tätigkeiten, Social Links; Text; weitere Friends.
import { getCollection } from 'astro:content';
import Redesign from '../../layouts/Redesign.astro';
import RCard from '../../components/RCard.astro';
import RBody from '../../components/RBody.astro';
import { friendsSorted, plainText } from '../../lib/content';
import { thumb } from '../../lib/media';
import { memberTypeName } from '../../lib/redesign';

export async function getStaticPaths() {
  return (await getCollection('friends')).map((friend) => ({ params: { slug: friend.id }, props: { friend } }));
}
const { friend } = Astro.props;
const f = friend.data;
const others = (await friendsSorted()).filter((x) => x.id !== friend.id).slice(0, 4);
const pic = f.profilePic ?? f.listImage ?? f.headerImage;
---
<Redesign title={f.name} description={plainText(f.excerpt ?? friend.body)} image={f.headerImage ?? pic}>
	<main>
		<section class="latest artist-head" style={`--cover:url("${f.headerImage ?? pic}")`}>
			<div class="latest-bg" aria-hidden="true"></div>
			<div class="wrap latest-grid">
				<RCard href={pic ?? '#about'} src={pic} label={f.name} eager class="latest-cover" />
				<div class="latest-info" data-reveal>
					<p class="crumb"><a href="/friends/">Friends</a></p>
					<h1 class="artist-name chrome-text">{f.name}</h1>
					{f.memberTypes.length > 0 && <p class="chips">{f.memberTypes.map((t) => <span class="chip ghost">{memberTypeName(t)}</span>)}</p>}
					{f.socials.length > 0 && <p class="chips">{f.socials.map((s) => <a class="chip" href={s.url} target="_blank" rel="noopener">{s.icon.replace(/^qticon-/, '')}</a>)}</p>}
				</div>
			</div>
		</section>

		<section class="block" id="about">
			<div class="wrap narrow">
				<div class="prose" data-reveal><RBody entry={friend} /></div>
			</div>
		</section>

		{others.length > 0 && (
			<section class="block">
				<div class="wrap">
					<h2 class="section-title" data-reveal>More Friends</h2>
					<div class="cards">
						{others.map((x, i) => <RCard href={`/members/${x.id}/`} src={thumb(x.data.listImage ?? x.data.headerImage ?? x.data.profilePic, 'gridthumb')} label={x.data.name} tilt={i % 2 ? 'r' : 'l'} delay={i * 80} />)}
					</div>
					<p class="more" data-reveal><a class="btn ghost" href="/friends/">All Friends</a></p>
				</div>
			</section>
		)}
	</main>
</Redesign>
