---
// Redesign: Member-Typ-Archiv — Friends mit dieser Tätigkeit als schräge Karten
import Redesign from '../../../layouts/Redesign.astro';
import RPageHead from '../../../components/RPageHead.astro';
import RCard from '../../../components/RCard.astro';
import { friendsSorted } from '../../../lib/content';
import { thumb } from '../../../lib/media';
import { memberTypeName } from '../../../lib/redesign';
import taxonomies from '../../../data/taxonomies.json';

export function getStaticPaths() {
  return Object.keys(taxonomies.membertype).map((term) => ({ params: { term } }));
}
const { term } = Astro.params as { term: string };
const name = memberTypeName(term);
const friends = (await friendsSorted()).filter((f) => f.data.memberTypes.includes(term));
---
<Redesign title={name} description={`Friends of Dicular Records: ${name}`}>
	<main>
		<RPageHead title={name} kicker="Friends" intro={`${friends.length} ${friends.length === 1 ? 'friend' : 'friends'}`} />
		<section class="block"><div class="wrap">
			<div class="cards friends">
				{friends.map((f, i) => <RCard href={`/members/${f.id}/`} src={thumb(f.data.listImage ?? f.data.headerImage ?? f.data.profilePic, 'gridthumb')} label={f.data.name} tilt={(['l', 'r', 's'] as const)[i % 3]} delay={(i % 4) * 80} />)}
			</div>
			<p class="more" data-reveal><a class="btn ghost" href="/friends/">All Friends</a></p>
		</div></section>
	</main>
</Redesign>
