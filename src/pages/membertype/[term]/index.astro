---
// Member-Typ-Archiv für Friends (taxonomy-membertype.php)
import Legacy from '../../../layouts/Legacy.astro';
import FeaturedImage from '../../../components/FeaturedImage.astro';
import FriendItem from '../../../components/FriendItem.astro';
import LoadMore from '../../../components/LoadMore.astro';
import { friendsSorted } from '../../../lib/content';
import taxonomies from '../../../data/taxonomies.json';
import site from '../../../data/site.json';

export async function getStaticPaths() {
  return Object.keys(taxonomies.membertype).map((term) => ({ params: { term } }));
}
const { term } = Astro.params as { term: string };
const name = (taxonomies.membertype as Record<string, string>)[term];
const friends = (await friendsSorted()).filter((f) => f.data.memberTypes.includes(term));
---
<Legacy critical="membertype" title={name} template="archive" bodyClass={`archive tax-membertype term-${term} term-${(taxonomies.ids.membertype as Record<string, number>)[term]}`}>
	<div class="qt-content qt-animatedheader">
		<FeaturedImage src={site.defaultHeader} variant="archive" />
		<header class="qt-header">
			<div class="container">
				<h1 class="qt-titdeco-eq text-center center">{name} </h1>
			</div>
		</header>
		<div class="container qt-archive " id="qtArchive">
			<div id="masonrycontainer" class="row qt-masonry masonrycontainer">
				{friends.map((f, i) => <FriendItem friend={f} first={i === 0} />)}
			</div>
			<LoadMore id="qtChartLoadmore" />
		</div>
	</div>
</Legacy>
