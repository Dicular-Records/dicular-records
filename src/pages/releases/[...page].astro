---
// V2: Release-Übersicht. Alle Releases nach Jahr, Cover wie hingeworfen; jedes Jahr färbt die Seite mit seinem ersten Cover.
// Alte Seitenadressen /releases/page/N/ leiten auf diese Seite um (netlify.toml; später .htaccess auf dem Server).
import Redesign from '../../layouts/Redesign.astro';
import RPageHead from '../../components/RPageHead.astro';
import V2Scatter from '../../components/V2Scatter.astro';
import { releasesSorted } from '../../lib/content';
import { thumb } from '../../lib/media';
import { coverColor } from '../../lib/cover-color';

export function getStaticPaths() {
  return [{ params: { page: undefined } }];
}
const releases = await releasesSorted();
const groups: { year: string; items: typeof releases }[] = [];
for (const r of releases) {
  const year = r.data.upcoming ? 'Coming soon' : r.data.date ? String(r.data.date.getUTCFullYear()) : 'Earlier';
  const g = groups.find((x) => x.year === year);
  if (g) g.items.push(r); else groups.push({ year, items: [r] });
}
const shown = await Promise.all(groups.map(async (g) => ({
  year: g.year,
  count: g.items.length,
  c: await coverColor(g.items[0].data.cover),
  tiles: await Promise.all(g.items.map(async (r) => ({ href: `/release/${r.id}/`, src: thumb(r.data.cover, 'gridthumb'), label: r.data.title, c: await coverColor(r.data.cover) }))),
})));
---
<Redesign title="Releases" description={`All ${releases.length} releases by Dicular Records`} image={releases[0].data.cover}>
	<main>
		<RPageHead title="Releases" kicker="Dicular Records Catalogue" intro={`${releases.length} releases — progressive house, trance and techno.`} image={releases[0].data.cover} />
		{shown.map((g, i) => (
			<section class="v2-sec" data-c={g.c}>
				<div class={`v2-head ${['', 'right', 'indent'][i % 3]}`}>
					<h2 class="year" data-reveal>{g.year}<span>{g.count} {g.count === 1 ? 'Release' : 'Releases'}</span></h2>
				</div>
				<V2Scatter items={g.tiles} phase={i * 3} />
			</section>
		))}
	</main>
</Redesign>
