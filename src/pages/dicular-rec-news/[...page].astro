---
// Redesign: News-Übersicht — neuester Beitrag groß, übrige als Kartenraster (Bild schräg, Datum, Titel, Anriss).
// Alte Seitenadressen /dicular-rec-news/page/N/ leiten auf diese Seite um.
import Redesign from '../../layouts/Redesign.astro';
import RPageHead from '../../components/RPageHead.astro';
import { newsSorted, plainText } from '../../lib/content';
import { thumb } from '../../lib/media';
import { fmtDate } from '../../lib/redesign';
import site from '../../data/site.json';

export function getStaticPaths() {
  return [{ params: { page: undefined } }];
}
const news = await newsSorted();
const [first, ...rest] = news;
const teaser = (n: typeof first, max: number) => plainText((n.data.excerpt ?? n.body ?? '').replace(/\*\*|##/g, ''), max);
---
<Redesign title="News" description="News from Dicular Records">
	<main>
		<RPageHead title="News" kicker="Dicular Rec News" intro={`${news.length} posts — releases, artists and label news.`} image={first.data.image} />

		<section class="block">
			<div class="wrap">
				<a href={`/${first.id}/`} class="news-feature" data-reveal>
					<span class="card tilt-l"><img src={first.data.image ?? site.shareImage} alt="" width="900" height="900" /></span>
					<span class="news-feature-text">
						<time>{fmtDate(first.data.date)}</time>
						<strong>{first.data.title}</strong>
						<em>{teaser(first, 260)}</em>
						<span class="btn">Read more</span>
					</span>
				</a>

				<div class="news-grid">
					{rest.map((n, i) => (
						<a href={`/${n.id}/`} class="news-card" data-reveal style={`--d:${(i % 3) * 80}ms`}>
							<span class={`card ${i % 2 ? 'tilt-r' : 'tilt-l'}`}>
								{n.data.image ? <img src={thumb(n.data.image, 'gridthumb')} alt="" width="500" height="500" loading="lazy" /> : <span class="card-empty" aria-hidden="true"></span>}
							</span>
							<time>{fmtDate(n.data.date)}</time>
							<strong>{n.data.title}</strong>
							<em>{teaser(n, 130)}</em>
						</a>
					))}
				</div>
			</div>
		</section>
	</main>
</Redesign>
