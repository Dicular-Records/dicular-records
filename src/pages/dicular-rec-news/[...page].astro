---
// V2: News-Übersicht. Neuester Beitrag groß mit übergreifendem Titel, die übrigen frei versetzt.
// Alte Seitenadressen /dicular-rec-news/page/N/ leiten auf diese Seite um.
import Redesign from '../../layouts/Redesign.astro';
import RPageHead from '../../components/RPageHead.astro';
import RNewsGrid from '../../components/RNewsGrid.astro';
import { newsSorted, plainText } from '../../lib/content';
import { fmtDate } from '../../lib/redesign';
import { coverColor } from '../../lib/cover-color';
import { cleanTitle, titleClass, titleFit } from '../../lib/v2';
import site from '../../data/site.json';

export function getStaticPaths() {
  return [{ params: { page: undefined } }];
}
const news = await newsSorted();
const [first, ...rest] = news;
const teaser = plainText((first.data.excerpt ?? first.body ?? '').replace(/\*\*|##/g, ''), 260);
---
<Redesign title="News" description="News from Dicular Records">
	<main>
		<RPageHead title="News" kicker="Dicular Rec News" intro={`${news.length} posts — releases, artists and label news.`} />

		<section class="v2-sec">
			<a href={`/${first.id}/`} class="v2-hero plain" data-c-hover={await coverColor(first.data.image)}>
				<span class="card tilt-l v2-hero-cover" data-reveal><img src={first.data.image ?? site.shareImage} alt="" width="900" height="900" /></span>
				<span class="v2-hero-info" data-reveal>
					<time class="kicker">{fmtDate(first.data.date)}</time>
					<span class={titleClass(first.data.title)} style={titleFit(first.data.title)}>{cleanTitle(first.data.title)}</span>
					<em class="v2-lead">{teaser}</em>
					<span class="btn">Read more</span>
				</span>
			</a>
			<RNewsGrid items={rest} />
		</section>
	</main>
</Redesign>
