---
// Redesign: Seiten auf oberster Ebene wie in WordPress — News-Beiträge und statische Seiten.
// Contact (sample-page) hat eine eigene Vorlage mit Demo-Formular, alle anderen Seiten sind Textseiten.
import { getCollection } from 'astro:content';
import RNews from '../components/RNews.astro';
import RPage from '../components/RPage.astro';
import RContact from '../components/RContact.astro';

export async function getStaticPaths() {
  // my-charts-2 = Dicular Digital → eigene Seite /dicular-digital/ (alte Adresse wird umgeleitet)
  const LIST_PAGES = ['home', 'releases', 'dicular-rec-news', 'artists', 'gigs', 'friends', 'my-charts-2'];
  const news = (await getCollection('news')).map((entry) => ({ params: { slug: entry.id }, props: { news: entry } }));
  const pages = (await getCollection('pages')).filter((p) => !LIST_PAGES.includes(p.id))
    .map((entry) => ({ params: { slug: entry.id }, props: { page: entry } }));
  return [...news, ...pages];
}
const { news, page } = Astro.props;
---
{news && <RNews entry={news} />}
{page && (page.id === 'sample-page' ? <RContact entry={page} /> : <RPage entry={page} />)}
