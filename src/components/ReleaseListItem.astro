---
// Release-Kachel der Übersichten (part-archive-item-release.php)
import type { CollectionEntry } from 'astro:content';
import { fitSize } from '../lib/media';
import { fmtLong } from '../lib/content';
interface Props { release: CollectionEntry<'releases'>; first?: boolean }
const { release, first } = Astro.props;
const r = release.data;
const [w, h] = await fitSize(r.cover, 350, 350);
---
<div class="col s6 m4 l3 ">
	<figure class="qt-release-listing qtSquaredItem">
		<img width={w} height={h} src={r.cover} class="img-responsive wp-post-image" alt={r.title} decoding="async" fetchpriority={first ? 'high' : undefined} loading={first ? undefined : 'lazy'} />
		<figcaption class="">
			<h2 class="qt-titdeco">{r.title}</h2>
			<p class="qt-metas hide-on-med-and-down">
				<i class="fa fa-tag"></i> {r.label}<br>{r.catalog && <Fragment><i class="fa fa-folder"></i> {r.catalog}<br></Fragment>}{r.date && <Fragment><i class="fa fa-calendar"></i> {fmtLong(r.date)}</Fragment>}
			</p>
			<a href={`/release/${release.id}/`}>
				read
			</a>
		</figcaption>
	</figure>
</div>
