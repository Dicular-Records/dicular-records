---
// V2: News-Beitrag. Bild schräg, Titel greift darüber, die Seite trägt die Farbe des Bildes; Text versetzt; weitere Beiträge.
// Das alte Kommentarformular entfällt im Entwurf (live gibt es keinen einzigen Kommentar; Entscheidung offen).
import type { CollectionEntry } from 'astro:content';
import Redesign from '../layouts/Redesign.astro';
import RBody from './RBody.astro';
import RNewsGrid from './RNewsGrid.astro';
import { relatedNews, plainText } from '../lib/content';
import { fmtDate } from '../lib/redesign';
import { coverColor } from '../lib/cover-color';
import { titleClass, titleFit } from '../lib/v2';
import taxonomies from '../data/taxonomies.json';

interface Props { entry: CollectionEntry<'news'> }
const { entry } = Astro.props;
const n = entry.data;
const related = (await relatedNews(entry)).filter((x) => x.id !== entry.id).slice(0, 3);
const cats = n.categories.filter((c) => c !== 'uncategorized').map((c) => ({ slug: c, name: (taxonomies.category as Record<string, string>)[c] ?? c }));
// Titel aus WordPress tragen teils Dekor wie "### News Flash ###" → für die Anzeige glätten
const title = n.title.replace(/#{2,}/g, '').replace(/\s{2,}/g, ' ').trim();
---
<Redesign title={title} description={plainText(n.excerpt ?? entry.body)} image={n.image} accent={n.image ? await coverColor(n.image) : undefined}>
	<main>
		<section class={`v2-hero sub${n.image ? '' : ' no-image'}`}>
			{n.image && <span class="card tilt-l v2-hero-cover" data-reveal><img src={n.image} alt="" width="900" height="900" fetchpriority="high" /></span>}
			<div class="v2-hero-info" data-reveal>
				<p class="crumb"><a href="/dicular-rec-news/">News</a></p>
				<p class="kicker">{fmtDate(n.date)}</p>
				<h1 class={titleClass(title)} style={titleFit(title)}>{title}</h1>
				{cats.length > 0 && <p class="chips">{cats.map((c) => <a class="chip ghost" href={`/category/${c.slug}/`}>{c.name}</a>)}</p>}
			</div>
		</section>

		<section class="block">
			<div class="v2-text"><div class="prose" data-reveal><RBody entry={entry} /></div></div>
		</section>

		{related.length > 0 && (
			<section class="v2-sec">
				<div class="v2-head right"><h2 class="section-title chrome-text" data-reveal>More News</h2></div>
				<RNewsGrid items={related} teaser={false} />
				<p class="v2-more" data-reveal><a class="btn ghost" href="/dicular-rec-news/">All News</a></p>
			</section>
		)}
	</main>
</Redesign>
