---
// News-Beitrag (single.php + part-single-post.php), Kommentarbereich, "Related articles"
import type { CollectionEntry } from 'astro:content';
import Legacy from '../layouts/Legacy.astro';
import Body from './Body.astro';
import FeaturedImage from './FeaturedImage.astro';
import RelatedCarousel from './RelatedCarousel.astro';
import CommentForm from './CommentForm.astro';
import { relatedNews, fmtDayMonth, plainText } from '../lib/content';
import taxonomies from '../data/taxonomies.json';
import site from '../data/site.json';

interface Props { entry: CollectionEntry<'news'> }
const { entry } = Astro.props;
const n = entry.data;
const path = `/${entry.id}/`;
const catName = (c: string) => (taxonomies.category as Record<string, string>)[c] ?? c;
const tagName = (t: string) => (taxonomies.tag as Record<string, string>)[t] ?? t;
const classes = `qt-content qt-fade-to-paper post-${n.wpId} post type-post status-publish format-standard${n.image ? ' has-post-thumbnail' : ''} hentry`
  + n.categories.map((c) => ` category-${c}`).join('') + n.tags.map((t) => ` tag-${t}`).join('');
const catLinks = n.categories.map((c) => `<a href="/category/${c}/" >${catName(c)}</a> `).join('');
const tagLinks = n.tags.length ? `<h5>Tagged as </h5><p>${n.tags.map((t) => `<a href="/tag/${t}/" rel="tag">${tagName(t)}</a>`).join(' ')}</p> ` : '';
const related = await relatedNews(entry);
---
<Legacy critical="post" title={n.title} image={n.image} description={plainText(n.excerpt ?? entry.body)} ogType="article" bodyClass={`wp-singular post-template-default single single-post postid-${n.wpId} single-format-standard`}>
	<div id="qwjquerycontent qt-single">
		<article class={classes} id={`post${n.wpId}`}>
			<FeaturedImage src={n.image ?? site.defaultHeader} />
			<header class="qt-header qt-fade-to-paper qt-single-part-post">
				<div class="container qt-tags">
					<div class="qt-reading-opt" set:html={catLinks}></div>
				</div>
				<h1 class="container qt-title">{n.title}</h1>
				<p class="container qt-metas text-center">
					<i class="fa fa-user"></i>
					<a href="/author/dicular-admin/" rel="author">{n.author}</a> <i class="fa fa-calendar"></i>
					{fmtDayMonth(n.date)}
				</p>
			</header>
			<div class="qt-paper">
				<main class="qt-post-content container">
					<div class="qt-reading-opt qt-post-content" role="main">
						<Body entry={entry} />
					</div>
				</main>
				<div class="container qt-tags">
					<div class="qt-reading-opt" set:html={tagLinks}></div>
				</div>
			</div>
		</article>
	</div>
	<footer>
	</footer>
	<CommentForm postPath={path} postId={n.wpId} />
	<RelatedCarousel heading="Related articles" dataItems={3} size="medium-thumb" linkClass="cmblink qwjquerycontent"
		items={related.map((r) => ({ href: `/${r.id}/`, image: r.data.image, title: r.data.title }))} />
</Legacy>
