---
// Release-Darstellung wörtlich aus dem Sonik-Theme (single-release.php / part-release.php):
// 360°-Player, Metas, Cover, Trackliste, Text. variant "home" = eingebettet auf der Startseite.
import type { CollectionEntry } from 'astro:content';
import ReleaseRow from "./ReleaseRow.astro";
import FeaturedImage from './FeaturedImage.astro';
import { audio } from '../lib/media';

interface Props { release: CollectionEntry<'releases'>; variant?: 'home' | 'single' }
const { release, variant = 'single' } = Astro.props;
const r = release.data;
const single = variant === 'single';

const playerId = `threesixtyplayer${release.id.replace(/[^a-z0-9]/gi, '').slice(-5)}`;
const firstTrack = r.tracks[0];
const playerTitle = r.playerTitle ?? firstTrack?.title;
const thumbClass = r.cover ? ' has-post-thumbnail' : '';
// Startseite (WPBakery-Shortcode) zeigt den 360°-Player immer, Release-Seiten nur mit headerPlayer
const showPlayer = !single || r.headerPlayer;
const headerClass = single ? (showPlayer ? 'qt-header qt-polydecor poly6' : 'qt-header ') : 'qt-header';
---
<article class={`qt-content qt-release-content${single ? ' qt-polydecor-page' : ''} post-${r.wpId} release type-release status-publish${thumbClass} hentry`} id={`page${r.wpId}`}>
	{single && <FeaturedImage src={r.background ?? r.cover} />}
	<header class={headerClass}>
		{showPlayer && (
			<Fragment>
				<div class="ui360 ui360-vis qt-releaseplayer" id={playerId}>
					{firstTrack?.mp3 && <a href={audio(firstTrack.mp3)} class="qt-header-play"></a>}
				</div>
				<div class="clearfix"></div>
				<div class="qt-releaseplayer-controls">
				</div>
				{(playerTitle !== undefined || firstTrack) && <h5 id="qtTracktitle" class="text-center tracktitle"><i class="fa fa-music"></i> {playerTitle ?? ''}</h5>}
			</Fragment>
		)}
		<h1 class="qt-titdeco-eq text-center">{r.title}</h1>
	</header>

	{single ? <div class="container qt-polydecor"><ReleaseRow release={release} playerId={showPlayer ? playerId : undefined} /></div> : <ReleaseRow release={release} playerId={playerId} />}
</article>
