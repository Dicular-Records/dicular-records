---
// Release-Darstellung wörtlich aus dem Sonik-Theme (part-release.php): 360°-Player, Metas, Cover, Trackliste, Text.
// Wird auf der Startseite (Featured Release) und auf den Release-Detailseiten verwendet.
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

interface Props { release: CollectionEntry<'releases'> }
const { release } = Astro.props;
const r = release.data;
const { Content } = await render(release);

const playerId = `threesixtyplayer${release.id.replace(/[^a-z0-9]/gi, '').slice(-5)}`;
const firstTrack = r.tracks[0];
const releasePage = `/release/${release.id}/`;
const dateText = r.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<article class={`qt-content qt-release-content post-${r.wpId} release type-release status-publish has-post-thumbnail hentry`} id={`page${r.wpId}`}>
	<header class="qt-header">
		<div class="ui360 ui360-vis qt-releaseplayer" id={playerId}>
			{firstTrack?.mp3 && <a href={firstTrack.mp3} class="qt-header-play"></a>}
		</div>
		<div class="clearfix"></div>
		<div class="qt-releaseplayer-controls">
		</div>
		{firstTrack && <h5 id="qtTracktitle" class="text-center tracktitle"><i class="fa fa-music"></i> {firstTrack.title}</h5>}
		<h1 class="qt-titdeco-eq text-center">{r.title}</h1>
	</header>

	<div class="row">
		<div class="col m12 s12 l4">
			<p class="qt-metas qt-release-metas  qt-border top  thick qt-border-color-ink">
				<i class="fa fa-tag"></i> {r.label}{r.catalog && <Fragment><i class="fa fa-folder"></i> {r.catalog}</Fragment>}<i class="fa fa-calendar"></i> {dateText}
			</p>
			<a class="qw-imgfx" href={r.cover}>
				<img decoding="async" width="900" height="900" src={r.cover} class="img-responsive wp-post-image" alt="" />
			</a>
			<div class="qt-tags">
			</div>
		</div>

		<div class="col m12 s12 l8">
			{r.tracks.length > 0 && (
				<ul class="qt-tracklist qt-border top bottom thick qt-border-color-ink">
					{r.tracks.map((t, i) => (
						<li>
							<div>
								<h4 class="qt-ellipsis">{t.title}</h4>
								<p class="qt-ellipsis">
									{t.artist}
								</p>
							</div>
							<p class="qt-act">
								{t.mp3 && (
									<a class={`playable-mp3-link btn btn-primary${i === 0 ? ' beingplayed' : ''}`} data-album={r.title} data-pathinfo="mp3" data-target={playerId} data-playtrack={t.mp3} data-title={t.title} data-author={t.artist} data-buyurl={t.buyUrl ?? ''} data-releasepage={releasePage} href="#">
										<i class="mdi-av-play-arrow"></i>
									</a>
								)}
							</p>
							<hr class="canc">
						</li>
					))}
				</ul>
			)}
			<div class="qt-thecontent">
				<Content />
			</div>
		</div>
	</div>
</article>
